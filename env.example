# Use true to test locally without AWS. Use false after the backend is deployed.
VITE_USE_MOCKS=true

# Copy these values from the backend CloudFormation/SAM stack Outputs.
VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.eu-west-2.amazonaws.com
VITE_AWS_REGION=eu-west-2
VITE_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
